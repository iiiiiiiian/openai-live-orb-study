{
  "name": "@horizon-lab/horizon-orb-ui",
  "version": "0.1.0",
  "description": "Horizon Orb UI adapters with a runnable local WebGL2 visual-study demo",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./styles.css": "./dist/orb.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "RENDERER-PROTOCOL.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-css.mjs && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-local.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "node -e \"throw new Error('This repository is distributed through GitHub, not npm')\""
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
