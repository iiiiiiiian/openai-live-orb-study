{
  "name": "@horizon-lab/horizon-orb-ui",
  "version": "0.1.0",
  "description": "UI-only React and vanilla host; renderer and recovered assets explicitly excluded",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {"node": ">=22.12.0"},
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./react": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./vanilla": {"types": "./dist/vanilla.d.ts", "import": "./dist/vanilla.js"},
    "./types": {"types": "./dist/types.d.ts", "import": "./dist/types.js"},
    "./styles.css": "./dist/orb.css"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE.md", "RENDERER-PROTOCOL.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-css.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "node -e \"throw new Error('Choose an original-code license and complete review before publishing')\""
  },
  "peerDependencies": {"react": ">=18 <20"},
  "peerDependenciesMeta": {"react": {"optional": true}},
  "devDependencies": {"typescript": "^5.9.0", "@types/react": "^19.0.0", "react": "^19.0.0", "react-dom": "^19.0.0"}
}
